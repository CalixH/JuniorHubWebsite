---
import Layout from "../layouts/Layout.astro";
---

<Layout description="Junior Hub is a licensed child care and learning centre near Hwy 7, 407 and Yonge Street offering toddler, preschool, kindergarten and summer camp programs. CWELCC enrolled; fee subsidy available.">
    <!-- Banner -->
    <section id="banner">
      <p id="popup">
        Enroll in Canada-Wide Early Learning and Childcare System/Childcare! <br />
        Fee subsidy is available
      </p>
      <h2>
        <b
          ><span
            style="
              font-family: 'Times New Roman', Times, serif;
              font-size: 2.6em;
              line-height: 80%;
              color: #ff8000;
              text-shadow: 0px 0px 2px #000;
            "
            >Junior Hub</span
          ></b
        >
      </h2>
      <p style="font-size: 2.3em">Child Care & Learning Centre</p>
      <ul class="actions special">
        <li style="font-size: 1.5em">
          <a href="/contact" class="button">Book A Tour</a>
        </li>
      </ul>
    </section>

    <!-- Main -->
    <section id="main" class="container">
      <section class="box special">
        <h4>
          <span style="font-weight: bold; font-size: 115%; color: #180658"
            ><span style="color: black; font-size: 125%; font-weight: bolder"
              >Toddler,Preschool, JK & SK</span
            >
            space available! <br />
            <span style="color: red"
              >PA Days, March Break, Summer Camp space available!</span
            > <br />
            Proudly enrolled in the Canada-Wide Early Learning & Child Care (CWELCC) System
            <br />
            <br />
            Toddler <br />
            (1.5yrs-2.5yrs) <br />
            Preschool <br />
            (2.5yrs-4yrs) <br />
            Kindergarten <br />
            (4yrs-6yrs before June 30th) <br />
            <br /><span style="color: red"
              >Refund includes PA Days, March Break, and Summer Camp</span
            ><br />
            <br />
            For more details of CWELCC, please visit
            <a
              href="https://www.york.ca/support/childrens-services/child-care-information-parents"
              target="_blank"
              rel="noreferrer noopener"
              >this link</a
            > </span
          > 
        </h4>

        <hr />
        <script is:inline src="https://apps.elfsight.com/p/platform.js" defer></script>
        <div class="elfsight-app-42d87d06-8681-46b0-bd00-befa29c45b50"></div>

        <hr />

        <h3>We are hiring new staff members!</h3>
        <div class="col-12-mobilep">
          <ul class="actions special">
            <li>
              <a href="/hiring" class="button">Hiring information</a>
            </li>
          </ul>
        </div>
        <hr />
        <h2>
          Every child is a different kind of flower. All together, <br />
          we make this world a beautiful garden. <br />
        </h2>
        <p
          style="
            font-size: 1.3em;
            color: rgb(97, 96, 96);
            text-align: right;
            padding-right: 40px;
          "
        >
          <i>~ Brigette Barrager</i>
        </p>
      </section>
    </section>

    <!-- CTA -->
    <section id="cta">
      <h2>Contact Us!</h2>
      <p>Click the buttons below to learn more about us!</p>

      <div class="col-12-mobilep">
        <ul class="actions special">
          <li><a href="/about" class="button">About Us</a></li>
          <li>
            <a href="/contactus" class="button">Contact information</a>
          </li>
          <li><a href="/contact" class="button">Book a tour</a></li>
          <li>
            <a href="/register" class="button">Join the waitlist</a>
          </li>
          <li>
            <a href="/summercampregister" class="button"
              >Summer camp registration</a
            >
          </li>
        </ul>
      </div>
    </section>
</Layout>
