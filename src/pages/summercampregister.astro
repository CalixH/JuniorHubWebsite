---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Summer Camp Registration" description="Register your child for Junior Hub summer camp.">
    <section id="banner">
      <h2>Register for Summer Camp!</h2>
    </section>

    <!-- Main -->
    <section id="main" class="container medium">
      <div class="box">
        <form
          method="post"
          action="/thanks"
          netlify
          data-netlify-recaptcha="true"
          name="SUMMER CAMP Registration"
        >
          <div class="row gtr-50 gtr-uniform">
            <div class="col-6 col-12-mobilep">
              <input
                type="text"
                name="fname"
                id="fname"
                value=""
                required
                placeholder="Child's First Name*"
              />
            </div>
            <div class="col-6 col-12-mobilep">
              <input
                type="text"
                name="lname"
                id="lname"
                value=""
                required
                placeholder="Child's Last Name*"
              />
            </div>
            <div class="col-12">
              <label for="birth">Birthdate</label>
              <input type="date" id="birth" required name="Birthdate" />
            </div>
            <div class="col-12">
              <textarea
                name="notes"
                id="notes"
                placeholder="Notes"
                rows="6"
              ></textarea>
            </div>
            <div class="col-4 col-12-mobilep">
              <input
                type="text"
                name="parent fname"
                id="parent fname"
                value=""
                required
                placeholder="Parent's First Name*"
              />
            </div>
            <div class="col-4 col-12-mobilep">
              <input
                type="text"
                name="parent lname"
                id="parent lname"
                value=""
                required
                placeholder="Parent's Last Name*"
              />
            </div>
            <div class="col-4 col-12-mobilep">
              <input
                type="tel"
                name="phone"
                id="phone"
                value=""
                placeholder="Phone"
              />
            </div>
            <div class="col-12">
              <input
                type="email"
                name="email"
                id="email"
                value=""
                required
                placeholder="Email*"
              />
            </div>
            <div class="col-12">
              <label for="start">Requested Start Date</label>
              <input
                type="date"
                id="start"
                name="Requested Start Date"
                placeholder="Requested Start Date"
              />
            </div>
            <div data-netlify-recaptcha="true" class="col-12"></div>
            <div class="col-12">
              <ul class="actions special">
                <li><input type="submit" value="Send Message" /></li>
              </ul>
            </div>
          </div>
        </form>
      </div>
    </section>
</Layout>
