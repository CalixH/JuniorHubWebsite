---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title="Thank You" description="Thanks for contacting Junior Hub." noindex>
  <!-- Banner -->
  <section id="banner">
    <h2><b><span style="color: white">Thank You!</span></b></h2>
  </section>

  <!-- Main -->
  <section id="main" class="container">
    <section class="box special">
      <p>
        We received your submission and will get back to you soon.
        If it's urgent, call us at <a href={`tel:${site.phone}`}>{site.phone}</a>
        or email <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <ul class="actions special">
        <li><a href="/" class="button">Back to Home</a></li>
      </ul>
    </section>
  </section>
</Layout>
