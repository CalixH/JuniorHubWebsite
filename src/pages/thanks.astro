---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<Layout title="Thank You" description="Thanks for contacting Junior Hub." noindex>
  <PageHero title="Thank you" lede="We received your message and will get back to you soon." />
  <div class="wrap page">
    <div class="prose">
      <p>
        If it is urgent, call <a href={`tel:${site.phone}`}>{site.phone}</a> or email
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <div class="actions">
        <a class="btn" href="/">Back to home</a>
      </div>
    </div>
  </div>
</Layout>
