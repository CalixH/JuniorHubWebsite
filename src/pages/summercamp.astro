---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="Summer Camp" description="Summer camp, PA day and March break programs at Junior Hub.">
  <PageHero
    title="Summer camp"
    lede="For children aged 4 to 6, July to September. Indoor and outdoor games, plus hands-on science, technology, engineering, art and math."
    back={{ href: "/program", label: "All programs" }}
    image="/images/c5.JPG"
  >
    <div class="actions" style="margin-top: 1.5rem">
      <a class="btn" href="/summercampregister">Register for camp</a>
    </div>
  </PageHero>

  <div class="wrap page">
    <div class="prose">
      <p>
        Junior Hub is pleased to offer a summer camp program for the children aged 4 to 6, July to September.
      </p>
      <p>
        Children will enjoy numerous fun and educational indoor and outdoor games and activities that are great for
        summer. They will also explore the world of STEAM with hands-on Science, Technology, Engineering, Art and Math
        powered activities with our expert educators.
      </p>

      <h2>Registration and fees</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Item</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Weekly, 9:00am to 5:00pm</td>
            <td>$322</td>
          </tr>
          <tr>
            <td>Extension care, 8:00am to 6:00pm</td>
            <td>+$40</td>
          </tr>
          <tr>
            <td>Meal plan option (hot lunch and 2 snacks)</td>
            <td>+$30</td>
          </tr>
        </tbody>
      </table>

      <h2>Important dates</h2>
      <p>Registration is required for a minimum of 2 weeks. Registration date: <strong>February 1</strong>.</p>
      <p>Camp will be closed on August 1st for the civic holiday (no charge on this day).</p>
    </div>

    <div class="prose wide">
      <h2>Weekly themes</h2>
      <div class="weeks">
          <div>
            <h3><img src="/images/music.png" alt="" width="28" height="28" />Week 1: Music Fun</h3>
          <ul>
            <li>Freeze dance</li>
            <li>Instruments party</li>
            <li>Musical chairs</li>
            <li>Cultural dances</li>
            <li>Hot potato</li>
            <li>Soft music with soft props</li>
            <li>Follow the rhythm</li>
            <li>Movement songs</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/cow.png" alt="" width="28" height="28" />Week 2: Down on the Farm</h3>
          <ul>
            <li>Petting zoo</li>
            <li>Planting seeds</li>
            <li>Making playdoh</li>
            <li>Fruit crafts</li>
            <li>Animal sounds</li>
            <li>Animal race</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/ship.png" alt="" width="28" height="28" />Week 3: Adventureland</h3>
          <ul>
            <li>Treasure hunt</li>
            <li>Pirate hats</li>
            <li>Costume day</li>
            <li>Reading and create a map</li>
            <li>Digging for treasures</li>
            <li>Building a boat</li>
            <li>Sailing race</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/globe.png" alt="" width="28" height="28" />Week 4: It's a Small World</h3>
          <ul>
            <li>Puppet show</li>
            <li>Costume of diverse cultures</li>
            <li>Costume day</li>
            <li>Reading and create a map</li>
            <li>Digging for treasures</li>
            <li>Building a boat</li>
            <li>Sailing race</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/gear.png" alt="" width="28" height="28" />Week 5: Imaginarium</h3>
          <ul>
            <li>Building ice castles</li>
            <li>Marshmallow architecture</li>
            <li>Fingerprint art</li>
            <li>“Big” inventors</li>
            <li>Creative Junk</li>
            <li>Free art with assorted items</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/star.png" alt="" width="28" height="28" />Week 6: Under the Stars</h3>
          <ul>
            <li>Glow in the dark play</li>
            <li>Camping dramatic play</li>
            <li>Picnic table</li>
            <li>Homemade s'mores and more</li>
            <li>Fishing</li>
            <li>Shadow puppets</li>
            <li>Observing with magnifying glasses</li>
            <li>Observing and reading about insects and worms</li>
            <li>Collecting and sorting out leaves</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/dolphin.png" alt="" width="28" height="28" />Week 7: Water fun</h3>
          <ul>
            <li>Water splash day</li>
            <li>Float or sink experiment</li>
            <li>Bubbles in water</li>
            <li>Build my own aquarium</li>
            <li>Ice play</li>
            <li>Five Little Ducks dramatic play</li>
            <li>Sensory bin activity</li>
            <li>Muddy animal dramatic play</li>
            <li>Color mixing water play</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/science.png" alt="" width="28" height="28" />Week 8: "Crazy" Science</h3>
          <ul>
            <li>Rainbow volcano</li>
            <li>Mixing colors experiment</li>
            <li>Lava lamp experiment</li>
            <li>Magic milk science experiment</li>
            <li>Explore with magnets</li>
            <li>Clouds and rain experiment</li>
            <li>Light and shade activity</li>
            <li>Mobius ring</li>
          </ul>
          </div>
          <div>
            <h3><img src="/images/medal.png" alt="" width="28" height="28" />Week 9: The Wild World of Sport</h3>
          <ul>
            <li>Animal race</li>
            <li>Medals and more</li>
            <li>Crab walk</li>
            <li>Simon says</li>
            <li>Animal stretches</li>
            <li>Relay race</li>
            <li>Sprints</li>
            <li>Pop bubbles</li>
            <li>Balancing games</li>
            <li>Hopscotch</li>
          </ul>
          </div>
      </div>

      <div class="actions">
        <a class="btn" href="/summercampregister">Register for camp</a>
        <a class="btn btn--ghost" href="/contact">Book a tour</a>
      </div>
    </div>
  </div>
</Layout>
