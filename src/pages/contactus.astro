---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="Contact Us" description="Phone, email and location for Junior Hub Child Care & Learning Centre.">
    <PageHero title="Contact Us" />

    <section class="container">
      <div class="box">
        <div class="row">
          <div class="row-12-mobilep">
            <h3>
              Email: <a href="mailto:info@juniorhub.ca">info@juniorhub.ca</a>
            </h3>
            <h3>Office Phone: <a href="tel:905-709-5777">905-709-5777</a></h3>
            <h3>
              Location:
              <a href="https://goo.gl/maps/dk6YSeDGr4xfXEz46"
                >8100 Yonge St. Unit #8-9</a
              >
            </h3>
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2878.514010315319!2d-79.4273791!3d43.8244391!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xbba87500e8008f1a!2sJunior%20Hub%20Child%20Care%20%26%20Learning%20Centre!5e0!3m2!1sen!2sca!4v1651197365600!5m2!1sen!2sca"
              width="600"
              height="450"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="row-12-mobilep">
            <h3>Business Hours:</h3>
            <table>
              <tr>
                <th>Day</th>
                <th>Hours</th>
              </tr>
              <tr>
                <td>Sunday</td>
                <td>Closed</td>
              </tr>
              <tr>
                <td>Monday</td>
                <td>7:30am - 6:00pm</td>
              </tr>
              <tr>
                <td>Tuesday</td>
                <td>7:30am - 6:00pm</td>
              </tr>
              <tr>
                <td>Wednesday</td>
                <td>7:30am - 6:00pm</td>
              </tr>
              <tr>
                <td>Thursday</td>
                <td>7:30am - 6:00pm</td>
              </tr>
              <tr>
                <td>Friday</td>
                <td>7:30am - 6:00pm</td>
              </tr>
              <tr>
                <td>Saturday</td>
                <td>Closed</td>
              </tr>
            </table>
          </div>
        </div>
      </div>
    </section>
</Layout>
