---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="grid">
      <div>
        <a class="brand" href="/">
          <img src="/images/jhlogo.png" alt="" width="44" height="44" />
          <span>Junior Hub</span>
        </a>
        <p>Licensed child care and learning centre near Hwy 7, 407 and Yonge Street.</p>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={`tel:${site.phone}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.mapUrl}>Find us on the map</a></li>
        </ul>
      </div>
      <div>
        <h2>Follow us</h2>
        <ul>
          {site.social.map((s) => (<li><a href={s.href}>{s.label}</a></li>))}
        </ul>
      </div>
    </div>
    <p class="legal">
      &copy; {year} {site.fullName}. Site design based on <a href="http://html5up.net">HTML5 UP</a>.
    </p>
  </div>
</footer>
