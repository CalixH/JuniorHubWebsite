---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const defaultDescription =
  "Junior Hub is a licensed child care and learning centre near Hwy 7, 407 and Yonge Street, with toddler, preschool, kindergarten and summer camp programs.";
const { title, description = defaultDescription, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | Junior Hub` : "Junior Hub | Child Care & Learning Centre";

// build.format is "file", so pathnames can end in .html; publish the clean URL.
const cleanPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const canonical = new URL(cleanPath, Astro.site).toString();

// Optional Google Analytics 4. Set PUBLIC_GA_ID (e.g. G-XXXXXXXXXX) in Netlify's
// environment variables to turn it on. Leave unset for no tracking.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && (<meta name="robots" content="noindex" />)}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/jhlogo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14412f" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/jhlogo.png", Astro.site).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap"
    />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <button class="to-top" type="button" aria-label="Back to top">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>
    <script>
      // Sticky header shadow and back-to-top button, driven by scroll position.
      const header = document.querySelector(".site-header");
      const toTop = document.querySelector(".to-top");
      if (header && toTop) {
        const SHOW_AFTER = 500; // px scrolled before the button appears
        let queued = false;
        const update = () => {
          const y = window.scrollY;
          header.classList.toggle("is-stuck", y > 4);
          toTop.classList.toggle("is-visible", y > SHOW_AFTER);
          queued = false;
        };
        window.addEventListener(
          "scroll",
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        update();
        toTop.addEventListener("click", () => {
          const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
          // Keyboard users: put focus back at the start of the page; the button hides itself at the top.
          document.querySelector(".brand")?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>
